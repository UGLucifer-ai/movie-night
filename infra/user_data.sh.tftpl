#!/bin/bash
# Runs once when the EC2 instance first boots.
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

mkdir -p /opt/movie-night/data
# The container runs as non-root UID 10001 (see Dockerfile); let it own the data dir.
chown 10001:10001 /opt/movie-night/data

docker pull ${container_image}
docker run -d \
  --name movie-night \
  --restart unless-stopped \
  -p 80:8000 \
  -v /opt/movie-night/data:/data \
  ${container_image}
